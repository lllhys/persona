{
  "id": "shared-sidebar-return",
  "manifestId": "android-large-window-shared-sidebar-return",
  "description": "Open an Inbox item beside the shared Assistant sidebar, resize the window in one process, then Back to the Inbox list with the sidebar still in place. The Inbox shows its item in the page itself, so the stack route stays inbox and the item is checked on the screenshots.",
  "requires": {
    "stackProbe": true,
    "fields": [
      "pid",
      "route",
      "selectedKey"
    ]
  },
  "steps": [
    {
      "step": "launch",
      "page": "inbox",
      "probePage": "Inbox"
    },
    {
      "step": "wm-size",
      "size": "900x1200",
      "density": 160,
      "widthDp": 900,
      "heightDp": 1200
    },
    {
      "step": "assert",
      "checks": {
        "pid": "unchanged",
        "route": {
          "equals": "inbox"
        },
        "window.widthDp": {
          "equals": 900
        }
      },
      "requires": {
        "page": "Inbox",
        "fields": [
          "firstVisibleKey",
          "firstVisibleOffsetPx"
        ]
      }
    },
    {
      "step": "capture",
      "name": "01-sidebar-inbox-list"
    },
    {
      "step": "tap",
      "text": "Direct",
      "index": 0
    },
    {
      "step": "assert",
      "checks": {
        "pid": "unchanged",
        "route": {
          "equals": "inbox"
        }
      }
    },
    {
      "step": "capture",
      "name": "02-sidebar-item-in-right-stack"
    },
    {
      "step": "wm-size",
      "size": "1200x900",
      "density": 160,
      "widthDp": 1200,
      "heightDp": 900
    },
    {
      "step": "assert",
      "checks": {
        "pid": "unchanged",
        "route": {
          "equals": "inbox"
        },
        "window.widthDp": {
          "equals": 1200
        }
      }
    },
    {
      "step": "capture",
      "name": "03-item-wide-landscape-window"
    },
    {
      "step": "wm-size",
      "size": "900x1200",
      "density": 160,
      "widthDp": 900,
      "heightDp": 1200
    },
    {
      "step": "assert",
      "checks": {
        "pid": "unchanged",
        "route": {
          "equals": "inbox"
        },
        "window.widthDp": {
          "equals": 900
        }
      }
    },
    {
      "step": "capture",
      "name": "04-item-narrow-portrait-window"
    },
    {
      "step": "key",
      "key": "BACK"
    },
    {
      "step": "assert",
      "checks": {
        "pid": "unchanged",
        "route": {
          "equals": "inbox"
        },
        "selectedKey": {
          "equals": null
        }
      },
      "requires": {
        "page": "Inbox",
        "fields": [
          "firstVisibleKey",
          "firstVisibleOffsetPx"
        ]
      }
    },
    {
      "step": "capture",
      "name": "05-back-restored-inbox-list"
    }
  ]
}
