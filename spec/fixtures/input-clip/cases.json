        "marker": true,
        "marker_key": "zz_persona_clipped_2",
        "input_bytes": 198946,
        "output_bytes": 24566,
        "array_items": 3500,
        "object_fields": 0,
        "remaining": 500
      }
    },
    {
      "name": "at_budget",
      "description": "An input already at the budget is returned without structural clipping or a marker.",
      "source": [
        "server/internal/transcript/clip.go: clipJSON",
        "integrations/runtime-sdk/lib/items.js: clipInput"
      ],
      "input": {
        "$pad_object_to": 24576,
