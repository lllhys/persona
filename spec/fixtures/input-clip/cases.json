{
  "version": 1,
  "cases": [
    {
      "name": "short_values",
      "description": "The issue's 4,000 rows of three short strings must fit the whole-input budget.",
      "source": [
        "https://github.com/nwverse/persona/issues/2907 item 2",
        "server/internal/transcript/clip.go: clipJSON",
        "integrations/runtime-sdk/lib/items.js: clipInput"
      ],
      "input": {
        "values": {
          "$repeat": 4000,
          "value": [
            {
              "$index": 0
            },
            {
              "$string": "a",
              "count": 17
            },
            {
              "$string": "b",
              "count": 18
            }
          ]
        }
      },
      "expected": {
        "check": "short_values",
        "input_bytes": 198902,
        "output_bytes": 24569,
        "remaining": 501,
        "array_items": 3499,
        "object_fields": 0,
        "marker": true
      }
    },
    {
      "name": "nested_arrays",
      "description": "Both outer rows and their retained nested arrays are shortened without processing detached arrays.",
      "source": [
        "server/internal/transcript/clip_bound.go: boundInputJSON",
        "integrations/runtime-sdk/lib/input-clip.js: boundInput"
      ],
      "input": {
        "outer": {
          "$repeat": 200,
          "value": {
            "$repeat": 100,
            "value": "x"
          }
        }
      },
      "expected": {
        "check": "nested_arrays",
        "marker": true,
        "input_bytes": 80411,
        "output_bytes": 24306,
        "array_items": 2070,
        "object_fields": 0,
        "remaining": 77,
        "inner": [78]
      }
    },
    {
      "name": "object_array",
