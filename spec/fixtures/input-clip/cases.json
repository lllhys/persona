        "android/feature/chat/src/main/kotlin/persona/feature/chat/ContentPresentation.kt: toolDiff"
      ],
      "input": {
        "file_path": "/home/user/project/a.go",
        "edits": {
          "$repeat": 2000,
          "value": {
            "old_string": "a",
            "new_string": "b"
          }
        }
      },
      "expected": {
        "check": "object_array",
        "marker": true,
        "input_bytes": 72049,
        "output_bytes": 24574,
        "array_items": 1322,
        "object_fields": 0,
        "remaining": 678
      }
    },
    {
      "name": "todo_array",
