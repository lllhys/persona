        "android/core/domain/src/main/kotlin/persona/core/domain/lines/TaskProgress.kt: rebuildTaskProgress"
      ],
      "input": {
        "todos": {
          "$repeat": 2000,
          "value": {
            "content": "Do the work",
            "activeForm": "Doing the work",
            "status": "pending"
          }
        }
      },
      "expected": {
        "check": "todo_array",
        "marker": true,
        "input_bytes": 150011,
        "output_bytes": 24504,
        "array_items": 1675,
        "object_fields": 0,
        "remaining": 325
      }
    },
    {
      "name": "question_array",
      "description": "A question list and its retained options keep their object shapes and value types.",
      "source": [
        "web/src/lib/tool-detail.ts: toolQuestions",
