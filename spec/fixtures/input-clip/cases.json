    {
      "name": "marker_collision",
      "description": "An existing marker-like user field is preserved and the synthetic marker gets a deterministic suffix.",
      "source": [
        "server/internal/transcript/clip_bound.go: boundInputJSON",
        "integrations/runtime-sdk/lib/input-clip.js: boundInput"
      ],
      "input": {
        "zz_persona_clipped": "keep this user value",
        "zz_persona_clipped_2": "keep this second user value",
        "values": {
          "$repeat": 4000,
          "value": [
            {
              "$index": 0
            },
            {
              "$string": "a",
              "count": 17
            },
            {
              "$string": "b",
              "count": 18
            }
          ]
        }
      },
      "expected": {
        "check": "marker_collision",
        "marker": true,
        "marker_key": "zz_persona_clipped_3",
        "input_bytes": 198999,
        "output_bytes": 24570,
        "array_items": 3501,
