{
  "schema_version": 1,
  "cases": [
    {
      "name": "stepped_submit_opens_review",
      "description": "On a card of several questions, Submit on the last one opens the review and sends nothing yet.",
      "source": [
        "apple/Persona/Views/Interactions/InteractionViews.swift: QuestionForm.submit, send",
        "apple/Persona/Views/Interactions/QuestionSteps.swift: QuestionSteps.enabled"
      ],
      "input": {
        "profile": "ios_current",
        "interaction": {
          "id": "example_request",
          "machine_id": "example_machine",
          "session_id": "example_session",
          "kind": "question",
          "questions": [
            {
              "question": "Which layout?",
              "header": "Layout",
              "multi_select": false,
              "options": [
                {
                  "label": "Compact (Recommended)"
                },
                {
                  "label": "Full"
                }
              ]
            },
            {
              "question": "Where should it go?",
              "header": "Place",
              "multi_select": false,
              "options": [
                {
                  "label": "This folder"
                },
                {
                  "label": "A temporary folder"
                }
              ]
            }
          ]
        },
        "operation": {
          "action": "submit",
          "page": 1,
          "picks": {
            "Which layout?": [
              "Full"
            ],
            "Where should it go?": [
              "This folder"
            ]
          },
          "other": {},
          "sending": false
        }
      },
      "expected": {
        "allowed": true,
        "resolution": null,
        "next_page": 1,
        "reviewing": true
      },
      "derived": true
    },
