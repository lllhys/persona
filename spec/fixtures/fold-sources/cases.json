      "expected": {
        "sources": [
          {
            "url": "https://weather.example.com/kyoto",
            "title": "Kyoto weather next week"
          },
          {
            "url": "https://travel.example.org/kyoto",
            "title": "Kyoto travel guide"
          }
        ]
      }
