          {
            "id": "use1#0",
            "seq": 1,
            "role": "assistant",
            "kind": "tool_use",
            "tool_use_id": "call_1",
            "tool_name": "WebSearch",
            "tool_input": {
              "query": "kyoto weather"
            }
          },
          {
            "id": "res1#0",
            "seq": 1,
            "role": "user",
            "kind": "tool_result",
            "tool_use_id": "call_1",
            "text": "Web search results for query: \"kyoto weather\"\n\nLinks: [{\"title\":\"Kyoto weather next week\",\"url\":\"https://weather.example.com/kyoto\"},{\"title\":\"Kyoto travel guide\",\"url\":\"https://travel.example.org/kyoto\"}]\n\nSummary of what was found."
          }
        ]
