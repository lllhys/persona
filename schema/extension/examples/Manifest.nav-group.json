{
  "manifest_version": 1,
  "id": "example-console",
  "name": "Example Console",
  "version": "1.0.0",
  "engines": {"extension_protocol": 1},
  "runtime": {"command": "bin/example-console", "rpc": "stdio"},
  "contributes": {"ui": [
    {"id": "today", "title": "Today", "placement": "nav_page", "icon": "calendar", "group": {"id": "workbench", "title": "工作台"}},
    {"id": "calendar", "title": "Calendar", "placement": "nav_page", "icon": "calendar", "group": {"id": "workbench", "title": "工作台"}},
    {"id": "assets", "title": "Assets", "placement": "nav_page", "icon": "money", "group": {"id": "assets", "title": "资产"}}
  ]}
}
